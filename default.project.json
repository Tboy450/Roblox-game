{
  "name": "roblox-game",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": "Packages" },
      "RetailRemotes": { "$path": "src/replicatedstorage/RetailRemotes" }
    },

    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },

    "ReplicatedFirst": {
      "$path": "src/replicatedfirst"
    },

    "Workspace": {
      "$path": "src/workspace",
      "$ignoreUnknownInstances": true
    }
  }
}
